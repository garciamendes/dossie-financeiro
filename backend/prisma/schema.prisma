// Schema do Dossiê Financeiro
// Reflete o modelo de dados definido em PRD_sistema_financeiro.md e SEGURANCA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identidade ----------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // null se login só por passkey
  pinHash      String? // PIN de 4 dígitos p/ confirmar ações via bot — nunca texto puro
  createdAt    DateTime @default(now())

  // MFA obrigatório (SEGURANCA.md, seção 1) — TOTP, nunca SMS.
  // O segredo TOTP é dado sensível: guardado cifrado (AES-256-GCM), nunca em claro.
  totpSecretEnc String?
  mfaEnabled    Boolean @default(false)

  // Bloqueio progressivo de login (SEGURANCA.md, seção 1).
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  memberships   HouseholdMember[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  preferences   UserPreferences?
  channelLinks  ChannelLink[]
}

model UserPreferences {
  id                  String  @id @default(cuid())
  userId              String  @unique
  user                User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme               Theme   @default(system)
  hideValuesByDefault Boolean @default(false)
}

enum Theme {
  dark
  light
  system
}

// Refresh tokens com rotação: cada token usado uma única vez.
// Reuso de um token já invalidado é sinal de possível roubo — ver SEGURANCA.md, seção 1.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
}

// Vínculo verificado de um número/conta de WhatsApp ou Telegram a um usuário
// (PRD: `linkedChannels`; SEGURANCA.md, seção 5: vínculo por código de confirmação).
// O bot em si é Fase 2 — aqui fica só o modelo e a verificação.
model ChannelLink {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String // "whatsapp" | "telegram"
  externalId   String // número E.164 ou chat id do Telegram
  verifyCode   String? // código de confirmação de uso único
  verifiedAt   DateTime?
  failedPinTries Int     @default(0)
  createdAt    DateTime  @default(now())

  @@unique([provider, externalId])
}

// ---------- Household (ficha compartilhada) ----------

model Household {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members              HouseholdMember[]
  invites              Invite[]
  accounts             Account[]
  charges              RecurringCharge[]
  installmentPurchases InstallmentPurchase[]
  goals                Goal[]
  transactions         Transaction[]
  auditLogs            AuditLog[]
  reminderLogs         ReminderLog[]
}

enum HouseholdRole {
  owner
  member
}

// Permissões granulares por membro — nunca um perfil fixo.
// O owner define; o backend valida de novo em cada endpoint (ver PermissionsGuard).
model HouseholdMember {
  id          String        @id @default(cuid())
  householdId String
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        HouseholdRole @default(member)

  canCreateCharge  Boolean @default(true)
  canEditCharge    Boolean @default(true)
  canDeleteCharge  Boolean @default(false)
  canMarkPaid      Boolean @default(true)
  canManageGoals   Boolean @default(true)
  canInviteMembers Boolean @default(false)
  canManageMembers Boolean @default(false) // exclusiva do owner na prática

  joinedAt DateTime @default(now())

  @@unique([householdId, userId])
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

model Invite {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  token       String       @unique
  channel     String? // whatsapp | telegram | link
  status      InviteStatus @default(pending)
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
}

// ---------- Financeiro ----------

enum AccountType {
  checking
  credit_card
  wallet
}

model Account {
  id          String      @id @default(cuid())
  householdId String
  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  type        AccountType
  institution String?

  // SEGURANCA.md, seção 2: saldo e número da conta são criptografados em
  // repouso, individualmente (AES-256-GCM), não só no disco do banco.
  // `balanceEnc` guarda o valor em centavos serializado e cifrado; null = 0.
  balanceEnc String?
  numberEnc  String? // número completo da conta, cifrado
  numberLast4 String? // últimos 4 dígitos, em claro, só p/ exibição mascarada "•••• 4821"

  createdAt DateTime @default(now())

  charges RecurringCharge[]

  @@index([householdId])
}

enum ChargeStatus {
  pending
  paid
  overdue
}

model RecurringCharge {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accountId   String?
  account     Account?     @relation(fields: [accountId], references: [id])
  description String
  amountCents Int
  dueDay      Int // dia do mês (1-31) em que vence
  category    String?
  status      ChargeStatus @default(pending)
  lastPaidAt  DateTime?

  remindDaysBefore  Int     @default(3)
  remindViaWhatsapp Boolean @default(true)
  remindViaTelegram Boolean @default(true)

  createdAt DateTime @default(now())

  reminderLogs ReminderLog[]

  @@index([householdId])
}

enum InstallmentStatus {
  active
  settled
}

// Compra parcelada — a transição current -> current+1 é automática
// no evento de pagamento (ver InstallmentsService.registerPayment).
model InstallmentPurchase {
  id                     String            @id @default(cuid())
  householdId            String
  household              Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  description            String
  installmentAmountCents Int
  totalInstallments      Int
  currentInstallment     Int               @default(0)
  nextDueDate            DateTime
  category               String?
  status                 InstallmentStatus @default(active)

  remindDaysBefore  Int     @default(3)
  remindViaWhatsapp Boolean @default(true)
  remindViaTelegram Boolean @default(true)

  createdAt DateTime @default(now())

  transactions Transaction[]
  reminderLogs ReminderLog[]

  @@index([householdId])
}

enum TransactionOrigin {
  manual
  whatsapp
  telegram
  bank
}

model Transaction {
  id                    String               @id @default(cuid())
  householdId           String
  household             Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  description           String?
  amountCents           Int
  occurredAt            DateTime             @default(now())
  category              String?
  origin                TransactionOrigin
  installmentPurchaseId String?
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id])
  createdByUserId       String
  createdAt             DateTime             @default(now())

  @@index([householdId, occurredAt])
}

model Goal {
  id                    String    @id @default(cuid())
  householdId           String
  household             Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name                  String
  targetAmountCents     Int
  currentAmountCents    Int       @default(0)
  targetDate            DateTime?
  suggestedMonthlyCents Int?
  createdAt             DateTime  @default(now())

  @@index([householdId])
}

// ---------- Lembretes (motor agendado — PRD seção 2, Fase 1) ----------

enum ReminderKind {
  upcoming // N dias antes do vencimento
  due_day // no dia do vencimento — "você pagou a fatura X?"
}

enum ReminderStatus {
  sent
  answered
  failed
}

model ReminderLog {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  chargeId              String?
  charge                RecurringCharge?     @relation(fields: [chargeId], references: [id], onDelete: Cascade)
  installmentPurchaseId String?
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: Cascade)

  kind      ReminderKind
  channels  String // csv: "telegram,whatsapp,console"
  dueDate   DateTime
  status    ReminderStatus @default(sent)

  // Chave de idempotência: um item + um tipo + uma data de vencimento
  // só gera um lembrete, mesmo que o scan rode várias vezes no dia.
  dedupeKey String @unique

  responseText   String?
  responseStatus ChargeStatus?
  respondedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([householdId, createdAt])
}

// ---------- Auditoria (feature visível no produto, aba "Atividades") ----------

model AuditLog {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  action      String // ex: "charge.marked_paid", "member.permission_changed"
  entityType  String // ex: "RecurringCharge", "InstallmentPurchase"
  entityId    String?
  channel     String // "web" | "whatsapp" | "telegram"
  summary     String // descrição pronta pra exibir na timeline, sem dado sensível cru
  createdAt   DateTime  @default(now())

  @@index([householdId, createdAt])
}
